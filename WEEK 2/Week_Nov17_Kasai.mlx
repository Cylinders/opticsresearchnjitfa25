%% ================================================================
% Week of November 17th - Doppler Velocity Analysis
% Methods 1-3 (from Nov 10) + Method 4 (Kasai Autocorrelation Eq.1)
% ================================================================

clear; clc; close all;
load('matlab_motion_.5v_5_1.mat');  

lambda_nm = 455;      % wavelength in nm
n = 1.33;             % refractive index
dt = 0.2;             % seconds per frame (sampling interval)

N_window = 256;       % total frames
N_interval = 10;      % lag between signals 
N_pzt = 19;           % period of PZT square wave (for ground truth only)

rowPix = 330; colPix = 527;   

data_input = im_data;

% FFT to find peak frequency
tmp_ts = permute(data_input(512,512,1:N_window), [3 1 2]);
data1d = abs(fft(tmp_ts));
figure; plot(data1d(3:64)); title('FFT magnitude at (512,512)');

N0 = 4;
[~, pRel] = max(data1d(N0:floor(N_window/2)));
peak_index = pRel + N0 - 1;

% Build complex analytic signal
data3d_fd = ifft(data_input(:,:,1:N_window), N_window, 3);

data3d_fd_half = data3d_fd;
data3d_fd_half(:,:,1:2) = 0;
data3d_fd_half(:,:,N_window/2+1:N_window) = 0;
data3d_fd_half = circshift(data3d_fd_half, [0 0 -peak_index]);
data3d_fd_half = fft(data3d_fd_half, [], 3);

% Extract single-pixel complex time series
complex_pixel_data = permute(data3d_fd_half(rowPix, colPix, :), [3 1 2]);
L = length(complex_pixel_data);

% Pre-calculate phase difference map for Method 1
data_doppler_3D = angle(data3d_fd_half(:,:,1+N_interval:N_window) .* ...
                        conj(data3d_fd_half(:,:,1:N_window-N_interval)));

% Phase unwrapping
data_doppler_3D(data_doppler_3D > 0.9*pi) = data_doppler_3D(data_doppler_3D > 0.9*pi) - pi;
data_doppler_3D(data_doppler_3D < -0.9*pi) = data_doppler_3D(data_doppler_3D < -0.9*pi) + pi;

% METHOD 1: Direct phase difference between points separated by N_interval
% v = λ/(4πn·N·δt) × Δφ

phi_method1 = permute(data_doppler_3D(rowPix, colPix, :), [3 1 2]);
phi_method1 = unwrap(phi_method1);
v_method1 = phi_method1 * lambda_nm / (4 * pi * n * N_interval * dt);
t1 = (1:length(v_method1)) * dt;

% METHOD 2: Calculate N_interval velocity estimates from overlapping pairs, average them
% v̄ = (1/N) × Σ vᵢ

maxStart = L - 2*N_interval;
v_method2 = zeros(maxStart, 1);

for t0 = 1:maxStart
    phi_i = zeros(N_interval, 1);
    for i = 0:N_interval-1
        s1 = complex_pixel_data(t0 + i);
        s2 = complex_pixel_data(t0 + i + N_interval);
        phi_i(i+1) = angle(s2 * conj(s1));
    end
    phi_avg = mean(phi_i);
    v_method2(t0) = phi_avg * lambda_nm / (4 * pi * n * N_interval * dt);
end

v_method2 = unwrap(v_method2);
t2 = (1:length(v_method2)) * dt;

% METHOD 3: Average N complex signals first, then calculate phase difference
% s₁ = (1/N) × Σ s(t+i), s₂ = (1/N) × Σ s(t+i+N)
% v = λ/(4πn·N·δt) × (arg(s₂) - arg(s₁))

v_method3 = zeros(maxStart, 1);

for t0 = 1:maxStart
    s1_block = complex_pixel_data(t0 : t0+N_interval-1);
    s2_block = complex_pixel_data(t0+N_interval : t0+2*N_interval-1);
    
    s1_avg = mean(s1_block);
    s2_avg = mean(s2_block);
    
    dphi = angle(s2_avg * conj(s1_avg));
    v_method3(t0) = dphi * lambda_nm / (4 * pi * n * N_interval * dt);
end

v_method3 = unwrap(v_method3);
t3 = (1:length(v_method3)) * dt;

% METHOD 4 (KASAI EQUATION 1): Kasai Autocorrelation Estimator
% R = Σ(m=0 to M-1) [S(t+m) × conj(S(t+m+N))]
% v = λ/(4πn·N·δt) × angle(R)

% Key difference from Method 3:
%   - Method 3: Average signals FIRST, then multiply
%   - Method 4: Multiply pairs FIRST, then sum (autocorrelation)

v_method4 = zeros(maxStart, 1);

for t0 = 1:maxStart
    R = 0;
    for m = 0:N_interval-1
        s1 = complex_pixel_data(t0 + m);
        s2 = complex_pixel_data(t0 + m + N_interval);
        R = R + s2 * conj(s1);  % Autocorrelation: sum of conjugate products
    end
    v_method4(t0) = lambda_nm / (4 * pi * n * N_interval * dt) * angle(R);
end

v_method4 = unwrap(v_method4);
t4 = (1:length(v_method4)) * dt;

% PZT signal
d_const = [];
for i = 1:floor(length(v_method1)/(2*N_pzt))
    for j = 1:N_pzt
        d_const((i-1)*2*N_pzt + j) = 1;
        d_const((i-1)*2*N_pzt + N_pzt + j) = -1;
    end
end
idealSig = circshift(0.5*1000*(d_const)*2.8/75, 6);
tPZT = (1:length(idealSig)) * dt;

% Method 1 vs PZT
figure;
L1 = min(length(v_method1), length(idealSig));
plot(t1(1:L1), v_method1(1:L1), 'b-', 'LineWidth', 1.5);
hold on;
plot(tPZT(1:L1), idealSig(1:L1), 'k--', 'LineWidth', 2);
title(['Direct Phase Difference (N = ' num2str(N_interval) ')']);
xlabel('Time (s)'); ylabel('Velocity (nm/s)');
%legend('Method 1', 'PZT Ground Truth', 'Location', 'northwest');
grid on;

% Method 2 vs PZT
figure;
L2 = min(length(v_method2), length(idealSig));
plot(t2(1:L2), v_method2(1:L2), 'r-', 'LineWidth', 1.5);
hold on;
plot(tPZT(1:L2), idealSig(1:L2), 'k--', 'LineWidth', 2);
title(['Multi-Pair Velocity Averaging (N = ' num2str(N_interval) ')']);
xlabel('Time (s)'); ylabel('Velocity (nm/s)');
%legend('Method 2', 'PZT Ground Truth', 'Location', 'northwest');
grid on;

% Method 3 vs PZT
figure;
L3 = min(length(v_method3), length(idealSig));
plot(t3(1:L3), v_method3(1:L3), 'Color', [0.9290 0.6940 0.1250], 'LineWidth', 1.5);
hold on;
plot(tPZT(1:L3), idealSig(1:L3), 'k--', 'LineWidth', 2);
title(['Complex Signal Averaging (N = ' num2str(N_interval) ')']);
xlabel('Time (s)'); ylabel('Velocity (nm/s)');
%legend('Method 3', 'PZT Ground Truth', 'Location', 'northwest');
grid on;

% Method 4 (Kasai) vs PZT
figure;
L4 = min(length(v_method4), length(idealSig));
plot(t4(1:L4), v_method4(1:L4), 'm-', 'LineWidth', 1.5);
hold on;
plot(tPZT(1:L4), idealSig(1:L4), 'k--', 'LineWidth', 2);
title(['Kasai Autocorrelation (N = ' num2str(N_interval) ')']);
xlabel('Time (s)'); ylabel('Velocity (nm/s)');
%legend('Method 4 (Kasai)', 'PZT Ground Truth', 'Location', 'northwest');
grid on;

% All Methods Comparison
figure;
Lmin = min([L1, L2, L3, L4]);
plot(t1(1:Lmin), v_method1(1:Lmin), 'b-', 'LineWidth', 1);
hold on;
plot(t2(1:Lmin), v_method2(1:Lmin), 'r-', 'LineWidth', 1);
plot(t3(1:Lmin), v_method3(1:Lmin), 'Color', [0.9290 0.6940 0.1250], 'LineWidth', 1);
plot(t4(1:Lmin), v_method4(1:Lmin), 'm-', 'LineWidth', 1);
plot(tPZT(1:Lmin), idealSig(1:Lmin), 'k--', 'LineWidth', 2);
title(['All Methods Comparison (N = ' num2str(N_interval) ')']);
xlabel('Time (s)'); ylabel('Velocity (nm/s)');
%legend('Method 1', 'Method 2', 'Method 3', 'Method 4 (Kasai)', 'PZT Ground Truth', 'Location', 'northwest');
grid on;

% Prepare data for metrics
minLen = min([length(idealSig), length(v_method1), length(v_method2), length(v_method3), length(v_method4)]);
truth = idealSig(1:minLen)';

pred_m1 = v_method1(1:minLen);
pred_m2 = v_method2(1:minLen);
pred_m3 = v_method3(1:minLen);
pred_m4 = v_method4(1:minLen);

% Method 1 metrics
rmse_1 = sqrt(mean((truth - pred_m1).^2));
mae_1 = mean(abs(truth - pred_m1));
R1 = corrcoef(truth, pred_m1); corr_1 = R1(1,2);

% Method 2 metrics
rmse_2 = sqrt(mean((truth - pred_m2).^2));
mae_2 = mean(abs(truth - pred_m2));
R2 = corrcoef(truth, pred_m2); corr_2 = R2(1,2);

% Method 3 metrics
rmse_3 = sqrt(mean((truth - pred_m3).^2));
mae_3 = mean(abs(truth - pred_m3));
R3 = corrcoef(truth, pred_m3); corr_3 = R3(1,2);

% Method 4 metrics
rmse_4 = sqrt(mean((truth - pred_m4).^2));
mae_4 = mean(abs(truth - pred_m4));
R4 = corrcoef(truth, pred_m4); corr_4 = R4(1,2);

Methods = {'Method 1: Direct Phase Diff'; 'Method 2: Multi-Pair Avg'; 'Method 3: Complex Signal Avg'; 'Method 4: Kasai Autocorr'};
RMSE = [rmse_1; rmse_2; rmse_3; rmse_4];
MAE = [mae_1; mae_2; mae_3; mae_4];
Correlation = [corr_1; corr_2; corr_3; corr_4];

Summary_Table = table(RMSE, MAE, Correlation, 'RowNames', Methods);
disp(Summary_Table);
